generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sessions      Session[]
  accounts      Account[]

  settings      Json?
  books         Book[]
  bookmarks     Bookmark[]
  progresses    Progress[]
  customThemes  CustomTheme[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

model Book {
  id            String     @id
  userId        String
  title         String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastReadAt    DateTime?
  blockCount    Int        @default(0)
  chunkCount    Int        @default(0)

  parentId      String?
  chapterIndex  Int?
  chapterTitle  String?
  totalChapters Int?
  nextBookId    String?
  prevBookId    String?

  isPublic      Boolean    @default(false)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Book?      @relation("BookChapters", fields: [parentId], references: [id], onDelete: Cascade)
  chapters   Book[]     @relation("BookChapters")
  chunks     Chunk[]
  bookmarks  Bookmark[]
  progress   Progress[]

  @@index([userId])
  @@index([parentId])
  @@index([isPublic])
  @@map("books")
}

model Chunk {
  id     String @id // `${bookId}:${index}`
  bookId String
  index  Int
  blocks Json

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, index])
  @@index([bookId])
  @@map("chunks")
}

model Progress {
  id        String   @id @default(uuid())
  bookId    String
  userId    String
  blockId   Int
  offset    Float
  percent   Float
  updatedAt DateTime @default(now())

  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId])
  @@map("progress")
}

model Bookmark {
  id        String   @id
  bookId    String
  userId    String
  blockId   Int
  snippet   String
  note      String?
  createdAt DateTime @default(now())

  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
  @@map("bookmarks")
}

model CustomTheme {
  id        String   @id
  userId    String
  name      String
  bg        String
  text      String
  accent    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("custom_themes")
}
