# ==============================================================================
# Supabase PostgreSQL Configuration
# ==============================================================================
# In Supabase: Project Settings -> Database -> Connection string -> URI

# 1. DATABASE_URL (Transaction Pooler - Port 6543)
# Used by Next.js app in serverless runtime. Appending ?pgbouncer=true tells Prisma
# to handle pooled connections properly without prepared statement collisions.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL (Direct Connection - Port 5432)
# Used by Prisma CLI for migrations and schema pushing (e.g. `pnpm db:push` or `npx prisma db push`).
# Direct connection is required because poolers in transaction mode block DDL migrations.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Secret key used to sign and verify JWT authentication cookies.
# Generate a random 32+ character string (e.g. `openssl rand -base64 32`).
JWT_SECRET="replace-with-a-secure-random-32-character-secret"
